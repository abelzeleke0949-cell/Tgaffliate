# Server Configuration
# 5000/3000 are already in use by another site on the VPS — kept off the defaults.
PORT=5001
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/cpa-hub

# Auth
# Generate a strong secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API
# (the brand dashboard, the admin dashboard, and the Mini App)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Shared secret the frontend must send in the X-Webhook-Secret header
# when calling POST /api/webhooks/chapa-mock (stands in for real Chapa signature
# verification until a live payment gateway is integrated)
CHAPA_WEBHOOK_SECRET=replace_with_a_random_string

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_DOMAIN=https://your-domain.com

# Frontend URLs (also kept for FRONTEND_URL fallback / bot deep links)
FRONTEND_URL=http://localhost:5173
MINI_APP_URL=http://localhost:5173/miniapp

# One-time bootstrap values read by `npm run create-admin` (optional — omit to be prompted)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
